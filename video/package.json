{
  "name": "flagflow-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "capture": "node scripts/capture.mjs",
    "voice": "node --env-file=.env scripts/voice.mjs",
    "render": "remotion render Wide out/flagflow-16x9.mp4 && remotion render Portrait out/flagflow-4x5.mp4",
    "render:wide": "remotion render Wide out/flagflow-16x9.mp4",
    "render:portrait": "remotion render Portrait out/flagflow-4x5.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.9.2"
  }
}
