NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://flagflow:flagflow@localhost:5432/flagflow
REDIS_URL=redis://localhost:6379/0
# 32+ random bytes; `npm run setup:env` generates one
JWT_ACCESS_SECRET=
REFRESH_TOKEN_TTL_DAYS=7
DASHBOARD_ORIGIN=http://localhost:5173
# Proxy hops in front of the API (0 locally; 1 behind Render's load balancer)
TRUST_PROXY=0
SMTP_URL=smtp://localhost:1025
MAIL_FROM="FlagFlow <no-reply@flagflow.local>"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Admin of the seeded "Acme" demo org
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
